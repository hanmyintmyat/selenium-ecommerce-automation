# Copy to .env and fill in the public demo password shown on the login page.
# Never commit .env. Shell/CI variables override .env values.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=replace-with-demo-password
TEST_ENV=qa
BROWSER=chrome
HEADLESS=false
EXPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30
# Optional override for pytest -n auto (default cap: 4 workers).
# PYTEST_XDIST_AUTO_NUM_WORKERS=2

# All environment aliases use Sauce Demo by default.
# QA_BASE_URL=https://www.saucedemo.com/
# LOCAL_BASE_URL=https://www.saucedemo.com/
# STAGING_BASE_URL=https://www.saucedemo.com/
# BASE_URL=https://www.saucedemo.com/

# Optional Selenium Grid; unset for locally managed drivers.
# SELENIUM_REMOTE_URL=http://localhost:4444
# Optional browser/driver paths (e.g. CI-provisioned compatible binaries).
# BROWSER_BINARY=/usr/bin/google-chrome
# Per-browser overrides take priority over BROWSER_BINARY.
# CHROME_BINARY=/usr/bin/google-chrome
# FIREFOX_BINARY=/path/to/native/firefox
# EDGE_BINARY=/usr/bin/microsoft-edge
# WEBDRIVER_PATH=/usr/bin/chromedriver
# Enable only in containers/environments that require disabling the sandbox.
CHROME_NO_SANDBOX=false
